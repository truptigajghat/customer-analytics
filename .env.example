# ==============================================================================
# ChurnQ Environment Configuration Template
# Copy this file to .env (frontend) and backend/.env (backend) for custom settings.
# ==============================================================================

# Frontend Configuration (Vite)
# ------------------------------------------------------------------------------
# URL of the Python ASGI/Uvicorn backend API service.
VITE_API_BASE_URL="http://localhost:8000"

# Optional app deployment URL
APP_URL="http://localhost:3000"

# Backend Configuration (ASGI / Uvicorn)
# ------------------------------------------------------------------------------
# Server listening port
PORT=8000

# Server host (0.0.0.0 for Docker / network access, 127.0.0.1 for local isolation)
HOST="0.0.0.0"

# Enable debug mode for verbose error tracing (set to false in production)
DEBUG=false

# Allowed CORS origins (comma-separated list for production, or * for open dev)
CORS_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"
